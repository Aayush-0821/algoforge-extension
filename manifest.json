{
  "manifest_version": 3,
  "name": "AlgoForge",
  "version": "0.1.0",
  "description": "Capture, analyze, and save coding problems with AlgoForge.",

  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:5000/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "AlgoForge"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "images/forgey.png"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ]
}